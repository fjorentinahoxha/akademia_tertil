---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Faqja nuk u gjet"
  description="Faqja që po kërkoni nuk ekziston. Kthehuni në ballinë ose shikoni kurset tona."
  noindex={true}
>
  <section class="section text-center">
    <div class="container">
      <span class="eyebrow">404</span>
      <h1>Kjo faqe nuk u gjet</h1>
      <p class="muted">Linku që ndoqët nuk ekziston ose mund të jetë lëvizur.</p>
      <div style="display:flex;gap:0.8rem;justify-content:center;margin-top:1.5rem;flex-wrap:wrap;">
        <a class="btn btn--primary" href="/">← Kthehu te Ballina</a>
        <a class="btn btn--ghost" href="/kurset">Shiko kurset</a>
      </div>
    </div>
  </section>
</Layout>
